
{
  "name": "iglesia-el-ancla-backend",
  "version": "1.0.0",
  "description": "API backend para la PWA de Iglesia El Ancla",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=./src/middleware/.env server.js",
    "dev": "nodemon --exec \"node --env-file=./src/middleware/.env\" server.js",
    "setup:initial-admin": "node --env-file=./src/middleware/.env src/scripts/admin/createInitialAdmin.js",
    "setup:second-super-admin": "node --env-file=./src/middleware/.env src/scripts/admin/createSecondSuperAdmin.js"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "mongoose",
    "iglesia-el-ancla"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "file-type": "^21.3.4",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mongoose": "^8.24.2",
    "morgan": "^1.11.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "transbank-sdk": "^6.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
